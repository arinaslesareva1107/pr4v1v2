import json
import os

TASKS_FILE = "tasks.json"

def load_tasks():
    try:
        if os.path.exists(TASKS_FILE):
            with open(TASKS_FILE, 'r', encoding='utf-8') as file:
                return json.load(file)
        else:
            return []
    except json.JSONDecodeError:
        print("Ошибка: файл tasks.json повреждён. Начинаем с пустого списка.")
        return []
    except PermissionError:
        print("Ошибка: нет прав доступа к файлу tasks.json")
        return []
    except Exception as e:
        print(f"Ошибка при загрузке задач: {e}")
        return []

def save_tasks(tasks):
    try:
        with open(TASKS_FILE, 'w', encoding='utf-8') as file:
            json.dump(tasks, file, ensure_ascii=False, indent=4)
        return True
    except PermissionError:
        print("Ошибка: нет прав для записи в файл tasks.json")
        return False
    except Exception as e:
        print(f"Ошибка при сохранении задач: {e}")
        return False

def generate_id(tasks):
    if not tasks:
        return 1
    return max(task['id'] for task in tasks) + 1

def add_task(tasks):
    print("\n--- Добавление новой задачи ---")
    title = input("Введите название задачи: ").strip()
    if not title:
        print("Название не может быть пустым!")
        return False
    
    description = input("Введите описание задачи: ").strip()
    
    task = {
        'id': generate_id(tasks),
        'title': title,
        'description': description,
        'status': False  
    }
    
    tasks.append(task)
    if save_tasks(tasks):
        print(f"Задача '{title}' добавлена с ID: {task['id']}")
        return True
    else:
        tasks.pop() 
        return False

def view_tasks(tasks):
    print("\n" + "="*60)
    print("СПИСОК ЗАДАЧ")
    print("="*60)
    
    if not tasks:
        print("Нет задач. Добавьте первую задачу!")
        return
    
    pending = [t for t in tasks if not t['status']]
    completed = [t for t in tasks if t['status']]
    
    if pending:
        print("\n НЕ ВЫПОЛНЕНЫ:")
        print("-"*60)
        for task in pending:
            status_text = " Не выполнена"
            print(f"ID: {task['id']} | {status_text}")
            print(f"   Название: {task['title']}")
            if task['description']:
                print(f"   Описание: {task['description']}")
            print("-"*40)
    
    if completed:
        print("\n ВЫПОЛНЕНЫ:")
        print("-"*60)
        for task in completed:
            status_text = " Выполнена"
            print(f"ID: {task['id']} | {status_text}")
            print(f"   Название: {task['title']}")
            if task['description']:
                print(f"   Описание: {task['description']}")
            print("-"*40)
    
    print(f"\nВсего задач: {len(tasks)} | Выполнено: {len(completed)} | Осталось: {len(pending)}")

def complete_task(tasks):
    if not tasks:
        print("Нет задач для отметки!")
        return
    
    view_tasks(tasks)
    try:
        task_id = int(input("\nВведите ID задачи, которую хотите отметить как выполненную: "))
        
        for task in tasks:
            if task['id'] == task_id:
                if task['status']:
                    print(f"Задача '{task['title']}' уже выполнена!")
                else:
                    task['status'] = True
                    if save_tasks(tasks):
                        print(f"Задача '{task['title']}' отмечена как выполненная!")
                    else:
                        task['status'] = False 
                return
        
        print(f"Задача с ID {task_id} не найдена!")
    except ValueError:
        print("Ошибка: ID должен быть числом!")

def delete_task(tasks):
    if not tasks:
        print("Нет задач для удаления!")
        return
    
    view_tasks(tasks)
    try:
        task_id = int(input("\nВведите ID задачи для удаления: "))
        
        for i, task in enumerate(tasks):
            if task['id'] == task_id:
                print(f"\nЗадача: {task['title']}")
                confirm = input("Вы уверены, что хотите удалить эту задачу? (да/нет): ").lower()
                
                if confirm == 'да' or confirm == 'yes':
                    deleted_task = tasks.pop(i)
                    if save_tasks(tasks):
                        print(f"Задача '{deleted_task['title']}' удалена!")
                    else:
                        tasks.insert(i, deleted_task)
                else:
                    print("Удаление отменено.")
                return
        
        print(f"Задача с ID {task_id} не найдена!")
    except ValueError:
        print("Ошибка: ID должен быть числом!")

def main():
    print("="*60)
    print("    МЕНЕДЖЕР ЗАДАЧ")
    print("="*60)
    
    tasks = load_tasks()
    print(f"Загружено задач: {len(tasks)}")
    
    while True:
        print("\n" + "-"*60)
        print("МЕНЮ:")
        print("1. Добавить задачу")
        print("2. Просмотреть все задачи")
        print("3. Отметить задачу как выполненную")
        print("4. Удалить задачу")
        print("5. Выход")
        print("-"*60)
        
        choice = input("Выберите действие (1-5): ").strip()
        
        if choice == '1':
            add_task(tasks)
        elif choice == '2':
            view_tasks(tasks)
        elif choice == '3':
            complete_task(tasks)
        elif choice == '4':
            delete_task(tasks)
        elif choice == '5':
            print("\nДо свидания! Задачи сохранены в файле tasks.json")
            break
        else:
            print("Ошибка: выберите число от 1 до 5!")

if __name__ == "__main__":
    main()
